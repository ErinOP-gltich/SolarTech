// Green Sun website — Cloudflare Pages project "solartech" (see README). Only the small Functions in functions/
// use these; the pages themselves are plain files. database_id is filled in during setup.
{
  "name": "solartech",
  "compatibility_date": "2025-09-01",
  "pages_build_output_dir": ".",
  "d1_databases": [
    { "binding": "DB", "database_name": "solartech", "database_id": "9c31129d-d6f0-4a2f-b3ea-ce751e2faaae" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "solartech-media" }
  ],
  "ai": { "binding": "AI" }   // Ask AI (functions/api/ask.js)
}
